# Single source of truth for everything the build is pinned to.
# Sourced by scripts/*.sh and read by .github/workflows/build.yml.

LIBFFI_VERSION=3.8.1
# SHA-256 of the upstream release tarball
# (https://github.com/libffi/libffi/releases/download/v$LIBFFI_VERSION/libffi-$LIBFFI_VERSION.tar.gz).
# Update it together with LIBFFI_VERSION.
LIBFFI_SHA256=81e879c094cc5ec3186c48510c6385ac6b3e866192e8bc71a35245703757ee40

# Selected with xcode-select in CI. The SDK it ships is recorded in every
# object's LC_BUILD_VERSION.
XCODE_VERSION=26.3

IOS_DEPLOYMENT_TARGET=13.0
# arm64 macabi does not exist below 14.0.
CATALYST_DEPLOYMENT_TARGET=14.0
TVOS_DEPLOYMENT_TARGET=13.0
VISIONOS_DEPLOYMENT_TARGET=2.0
